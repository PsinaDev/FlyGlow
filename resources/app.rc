#include <winver.h>

IDI_ICON1 ICON "flyglow.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FLYGLOW_VERSION_RC
PRODUCTVERSION FLYGLOW_VERSION_RC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FlyGlow"
            VALUE "FileDescription", "FlyGlow - lighting editor for the Flydigi CD2 dock"
            VALUE "FileVersion", FLYGLOW_VERSION
            VALUE "InternalName", "FlyGlow"
            VALUE "OriginalFilename", "FlyGlow.exe"
            VALUE "ProductName", "FlyGlow"
            VALUE "ProductVersion", FLYGLOW_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
